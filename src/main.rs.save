use clap::{Parser, Subcommand};
use std::fs;
use std::fs::OpenOptions;
use std::io::Write;

#[derive(Parser)]
struct Cli {
    #[command(subcommand)]
    command: Commands,
}

#[derive(Subcommand)]
enum Commands {
    Add {
        task: String,
    },
    List,
}

fn main() {
    let cli = Cli::parse();

    match cli.command {
        Commands::Add { task } => {
            let mut file = OpenOptions::new()
                .append(true)
                .create(true)
                .open("todos.txt")
                .unwrap();

            writeln!(file, "{}", task).unwrap();

            println!("追加しました");
        }

        Commands::List => {
            println!("一覧表示");
        }
    }
}











































































