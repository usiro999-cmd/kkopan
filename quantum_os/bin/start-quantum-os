#!/usr/bin/env bash
set -euo pipefail

if (($# > 0)); then
    exec "$@"
fi

if [[ -z "${JUPYTER_TOKEN:-}" ]]; then
    echo "JUPYTER_TOKEN is required; refusing to start an unauthenticated server." >&2
    exit 64
fi

exec jupyter lab \
    --ip=0.0.0.0 \
    --port=8888 \
    --no-browser \
    --ServerApp.token="${JUPYTER_TOKEN}" \
    --ServerApp.password='' \
    --ServerApp.allow_remote_access=true \
    --ServerApp.root_dir=/workspace
